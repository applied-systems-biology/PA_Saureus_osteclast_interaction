      },
      "3b2de3de-fa6f-4ab2-b9f4-8f88ca6a8959/jipipe:node:ui-locked" : {
        "pinned" : true,
        "hidden" : true,
        "name" : "Lock location/size",
        "description" : "If enabled, lock the location and size of this node. Does not affect automated alignment operations. Will lock the size if the node supports a resize handle. Will prevent deletion of the node by the user. Slots can still be edited/connected and parameters can still be changed."
      },
      "1b1c81b7-f08b-4ebb-9fce-5e82dfaa7efe/jipipe:adaptive-parameters/overridden-parameters" : {
        "important" : true,
        "name" : "Overridden parameters",
        "description" : "Here you can override the value of parameters based on annotations. The 'Value' settings should return a value for the parameter type or a JSON string that can be converted into a valid parameter value. The 'Parameter key' setting determines to which parameter this value is written to."
      },
      "7ee83ac5-75f5-4fda-beb7-dc53bbe34d7b/auto-update-output-slot-label" : {
        "name" : "Auto-label output slot",
        "description" : "If enabled, the label of the output slot is automatically set to the current file/directory name if there is exactly one path"
      },
      "944f2f9e-0b30-4c32-b598-7bfbcb248404/max-particle-size" : {
        "name" : "Max particle size",
        "description" : "The maximum particle size in the specified unit of the input image. If no unit is available, the unit is 'pixels'. If an object is not within the size range, it is removed from the results."
      },
      "84a82155-4d58-40d4-b6ad-2a93cec3b69f/jipipe:adaptive-parameters/parameter-annotations-use-internal-names" : {
        "name" : "Parameter annotations use internal names",
        "description" : "Generated parameter annotations use their internal unique names."
      },
      "a4e5df58-b6be-4e78-91c3-52c8a95579c4/jipipe:adaptive-parameters/enabled" : {
        "name" : "Enable adaptive parameters",
        "description" : "If enabled, you can use custom expressions to generate parameters. Please note that this will disable parallelization."
      },
      "94fbbce2-e998-4e26-82fa-74652fe6ba45/jipipe:data-batch-generation/force-na-is-any" : {
        "name" : "Force NA is ANY (if available)",
        "description" : "If enabled, missing annotations are considered as ANY (and thus merged with other data) even if there is only one input. Currently only works for the dictionary solver."
      },
      "4124166a-f110-4d78-9b7e-eff365576408/file-path" : {
        "name" : "File path",
        "description" : "Expression that generates the output file path\n\nThis function should return a valid file path string, which can be either hardcoded or built using string or <code>PATH_COMBINE</code> operations.\n\nHard-cording file paths: Just type the path into quotes as shown below <pre>\"C:/MyData/Outputs/Output_file\"</pre>\n\nUsing path combination: You can combine combine variables provided from annotations and expression variables to, for example, save create a path relative to the project directory or to a project user path<pre>PATH_COMBINE(project_dir, \"Outputs\", \"Output_file\")</pre><pre>PATH_COMBINE(project_user_paths [\"outputs\"], \"Outputs\", \"Output_file\")</pre>Alternative: <pre>PATH_COMBINE(project_user_path.outputs, \"Outputs\", \"Output_file\")</pre>\n\nUsing expression functions: You can also use the standard string concatenation function to generate paths<pre>project_dir + \"/Outputs/Output_file\"</pre>"
      },
      "22f98b86-1163-4799-b733-723fa090ade3/jipipe:adaptive-parameters/parameter-annotations-prefix" : {
        "name" : "Parameter annotation prefix",
        "description" : "Text prefixed to generated parameter annotations."
      },
      "5d6ef8f6-5c60-4c09-b031-2d60fa9c179b/jipipe:parameter-slot-algorithm/parameter-annotations-prefix" : {
        "name" : "Parameter annotation prefix",
        "description" : "Text prefixed to generated parameter annotations."
      },
      "e37f72fe-0458-4a36-a126-e9f5eea44618/ignore-missing-channels" : {
        "name" : "Ignore missing channels",
        "description" : "If enabled, the algorithm silently skips invalid assignments like extracting the 4th channel of a 2-channel image. If disabled, an error will be thrown if such a condition is detected."
      },
      "12adca09-ed91-4652-bea7-ee4c3e12b5af/jipipe:algorithm:runtime-partition" : {
        "pinned" : true,
        "name" : "Partition",
        "description" : "Allows to move the node into a different runtime partition, which determine how the workload is executed."
      },
      "e5c86e20-70c3-4907-8434-a6462cea6c92/jipipe:data-batch-generation/annotation-merge-strategy" : {
        "name" : "Merge same annotation values",
        "description" : "Determines which strategy is applied if different values for the same annotation columns are encountered."
      },
      "a83cead5-d1ec-46c4-8a02-9bafab9bcab1/auto-scale" : {
        "name" : "Auto scale",
        "description" : "Stretches the channel histograms to each channel's global minimum and maximum value throughout the stack. Does not alter underlying values in the image.  If unselected, all channel histograms are scaled to the image's digitization bit depth. Note that this range may be narrower than the bit depth of the file. For example, a 16-bit file may contain intensities digitized to 16-bits (0-65,535), to 12-bits (0-4,095), to 10-bits (0-1,023), etc.  Note that you can use the Brightness & Contrast or Window/Level controls to adjust the contrast range regardless of whether this option is used. The histogram will provide min/max values in the stack."
      },
      "944f2f9e-0b30-4c32-b598-7bfbcb248404/min-particle-circularity" : {
        "name" : "Min particle circularity",
        "description" : "The minimum circularity (circularity = 4pi(area/perimeter^2)). The value range is from 0-1. If an object is not within the circularity range, it is removed from the results."
      },
      "73d19a47-325e-405d-8be8-a1824eac9354/jipipe:data-batch-generation/limit" : {
        "name" : "Limit",
        "description" : "Limits which iteration steps are generated. The first index is zero."
      },
      "a48844b7-f73b-4fd8-bac4-67a329f20d3e/jipipe:parameter-slot-algorithm/has-parameter-slot" : {
        "name" : "Multiple parameters",
        "description" : "If enabled, there will be an additional slot that consumes parameter data sets. The algorithm then will be applied for each of this parameter sets."
      },
      "985a2918-6286-442c-a8fc-04ad9ccddf1f/jipipe:algorithm:enabled" : {
        "pinned" : true,
        "name" : "Enabled",
        "description" : "If disabled, this algorithm will be skipped in a run. Please note that this will also disable all algorithms dependent on this algorithm."
      },
      "5d6ef8f6-5c60-4c09-b031-2d60fa9c179b/jipipe:algorithm:pass-through" : {
        "pinned" : true,
        "name" : "Pass through",
        "description" : "If enabled, the algorithm will pass the input data directly to the output data without any processing. This is different from enabling/disabling the algorithm as this will not disable dependent algorithms.\nPlease note that setting this parameter via adaptive parameters (if available) does not always yield the expected result. The reason behind this is that pass-through is not trivial for certain nodes. We recommend to use a split node if node execution should be made adaptive."
      },
