        "description" : "Algorithms with multiple inputs require to match the incoming data to data sets. This allows you to determine how interesting data annotation columns are extracted from the incoming data. Union matches using the union of annotation columns. Intersection intersects the sets of available columns. You can also customize which columns should be included or excluded."
      },
      "ea08e9f8-e2e4-4316-ae7f-d3f0c822ea84/diameter-annotation" : {
        "name" : "Annotate with diameter",
        "description" : "If enabled, the diameter is attached as annotation. Useful if you want to let Cellpose estimate the object diameters."
      },
      "362c17fe-afa6-4fe2-83cb-190c92f06c11/jipipe:algorithm:pass-through" : {
        "pinned" : true,
        "name" : "Pass through",
        "description" : "If enabled, the algorithm will pass the input data directly to the output data without any processing. This is different from enabling/disabling the algorithm as this will not disable dependent algorithms.\nPlease note that setting this parameter via adaptive parameters (if available) does not always yield the expected result. The reason behind this is that pass-through is not trivial for certain nodes. We recommend to use a split node if node execution should be made adaptive."
      },
      "821f82b3-a94b-40d8-8503-e20ac31c775e/split-focal-planes" : {
        "name" : "Split focal planes",
        "description" : "Each focal plane is opened as a separate stack."
      },
      "1e12cbbf-7a7b-4f9d-9dc5-ee59d2647fee/jipipe:node:ui-locked" : {
        "pinned" : true,
        "hidden" : true,
        "name" : "Lock location/size",
        "description" : "If enabled, lock the location and size of this node. Does not affect automated alignment operations. Will lock the size if the node supports a resize handle. Will prevent deletion of the node by the user. Slots can still be edited/connected and parameters can still be changed."
      },
      "57e7ef39-917e-4c78-a3e6-da5806ae77ad/border-parameters/jipipe:node:ui-locked" : {
