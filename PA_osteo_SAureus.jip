        "description" : "If enabled, override the partition- and run-wide parallelization settings and apply parallelization only on this node."
      },
      "821f82b3-a94b-40d8-8503-e20ac31c775e/color-mode" : {
        "name" : "Color mode",
        "description" : "Color mode - Visualizes channels according to the specified scheme.  Possible choices are:\nDefault - Display channels as closely as possible to how they are stored in the file.\nComposite - Open as a merged composite image. Channels are colorized according to metadata present in the dataset (if any), or in the following default order: 1=red, 2=green, 3=blue, 4=gray, 5=cyan, 6=magenta, 7=yellow.\nColorized - Open with each channel in a separate plane, colorized according to metadata present in the dataset (if any), or in the default order (see Composite above).\nGrayscale - Open with each channel in a separate plane, displayed in plain grayscale.\nCustom - Same as Colorized, except that you can explicitly choose how to colorize each channel.\nNote that ImageJ can only composite together 7 or fewer channels. With more than 7 channels, some of the modes above may not work."
      },
      "3b2de3de-fa6f-4ab2-b9f4-8f88ca6a8959/jipipe:data-batch-generation/annotation-matching-method" : {
        "name" : "Annotation matching method",
        "description" : "Allows to customize when two annotation sets are considered as equal. By default, non-empty annotation values should match exactly. You can also use a custom expression, instead."
      },
      "7bbeaa9e-d475-44ef-a009-de2dfbdb943c/jipipe:adaptive-parameters/enabled" : {
        "name" : "Enable adaptive parameters",
        "description" : "If enabled, you can use custom expressions to generate parameters. Please note that this will disable parallelization."
      },
      "cdbb939a-72b6-4f7b-9af1-e9c117dcb0e8/jipipe:adaptive-parameters/overridden-parameters" : {
        "important" : true,
        "name" : "Overridden parameters",
        "description" : "Here you can override the value of parameters based on annotations. The 'Value' settings should return a value for the parameter type or a JSON string that can be converted into a valid parameter value. The 'Parameter key' setting determines to which parameter this value is written to."
      },
      "366f4e8f-801c-4823-a54e-3c5bdf3b4cf6/jipipe:data-batch-generation/column-matching" : {
        "important" : true,
        "pinned" : true,
        "name" : "Grouping method",
        "description" : "Algorithms with multiple inputs require to match the incoming data to data sets. This allows you to determine how interesting data annotation columns are extracted from the incoming data. Union matches using the union of annotation columns. Intersection intersects the sets of available columns. You can also customize which columns should be included or excluded."
      },
      "836b2914-72db-41af-8778-90545255a958/jipipe:data-batch-generation/limit" : {
        "name" : "Limit",
        "description" : "Limits which iteration steps are generated. The first index is zero."
      },
      "985a2918-6286-442c-a8fc-04ad9ccddf1f/enable-filter" : {
        "important" : true,
        "name" : "Enable filter",
        "description" : "Determines if the filter is enabled"
      },
      "058d6d3d-2346-4b6d-9b26-d7dd1330b613/jipipe:data-batch-generation/solver-preference" : {
        "pinned" : true,
        "name" : "Solver",
        "description" : "Allows to override the iteration step solver"
      },
      "1b1c81b7-f08b-4ebb-9fce-5e82dfaa7efe/sigma-x" : {
        "name" : "Sigma (X)",
        "description" : "Standard deviation of the Gaussian (pixels) in X direction. "
      },
      "1b1c81b7-f08b-4ebb-9fce-5e82dfaa7efe/sigma-y" : {
        "name" : "Sigma (Y)",
        "description" : "Standard deviation of the Gaussian (pixels) in Y direction. If zero or less, sigma in X direction is automatically used instead."
      },
      "02f346c4-d088-42f1-b306-41808992ba34/jipipe:node:bookmarked" : {
