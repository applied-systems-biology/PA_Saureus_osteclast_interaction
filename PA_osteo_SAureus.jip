      "57e7ef39-917e-4c78-a3e6-da5806ae77ad/border-parameters/border-mode" : {
        "name" : "Mode",
        "description" : "Determines how border values are generated\n\n<ul><li>Constant: Set the border to a constant value (zero/black unless configurable)</li><li>Repeat: Repeat the nearest non-border pixel</li><li>Mirror: Mirror the pixel values across the border</li><li>Tile: Tile the image</li></ul>"
      },
